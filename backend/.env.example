# Backend Server Port
PORT=5000

# Gmail SMTP Configuration (SSL / TLS on port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Sender Gmail Address (e.g., yourname@gmail.com)
SMTP_USER=

# 16-character Google App Password (NOT your regular Gmail password)
# Generated from: Google Account > Security > 2-Step Verification > App Passwords
SMTP_PASS=

# Destination email where enquiry submissions should be delivered (e.g. balajiassociates@gmail.com)
RECEIVER_EMAIL=
